name: workspace-ci
on: [push, pull_request]

# CI for a workspace scaffolded from pbg-template.
# Sequence:
#   1. Check out workspace + submodules.
#   2. Set up venv + install workspace deps editably.
#   3. Lint workspace.yaml against the JSON schema.
#   4. Run pytest at the workspace root (test_core_integration.py + test_phases.py + any user tests).
#
# This file ships in pbg-template as `.j2` so GitHub does NOT run it on the
# template repo itself (which has no real pyproject.toml). template-init.sh
# renders it to `.yml` when a user scaffolds a workspace.

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install uv
        run: pip install uv
      - name: Set up venv and install
        run: |
          uv venv .venv
          source .venv/bin/activate
          uv pip install -e ".[dev]"
      - name: Lint workspace
        run: |
          source .venv/bin/activate
          python scripts/lint-workspace.py
      - name: Run workspace tests
        if: hashFiles('tests/**/*.py') != ''
        run: |
          source .venv/bin/activate
          pytest tests/ -v
