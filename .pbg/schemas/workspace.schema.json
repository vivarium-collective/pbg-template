{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "workspace.yaml",
  "type": "object",
  "required": ["schema_version", "name", "created", "plugin_version", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "created": {"type": "string", "format": "date"},
    "plugin_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stages": {
      "type": "object",
      "required": ["workspace_bootstrap"],
      "properties": {
        "workspace_bootstrap": {"$ref": "#/definitions/stageStatus"}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/model"}
    },
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/definitions/dataset"}
    },
    "references_bib": {"type": "string"},
    "server": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "imports": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/import"}
    },
    "expert_docs": {
      "type": "array",
      "items": {"$ref": "#/definitions/expertDoc"}
    },
    "references_pdfs": {
      "type": "array",
      "items": {"$ref": "#/definitions/referencePdf"}
    }
  },
  "definitions": {
    "stageStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["planned", "in_progress", "complete"]},
        "pr": {"type": ["integer", "null"]},
        "completed": {"type": ["string", "null"]}
      }
    },
    "model": {
      "type": "object",
      "required": ["submodule_path", "remote", "pbg_processes", "stages"],
      "properties": {
        "submodule_path": {"type": "string"},
        "remote": {"type": "string"},
        "pbg_processes": {"type": "array", "items": {"type": "string"}},
        "stages": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/stageStatus"}
        },
        "phases": {
          "type": "array",
          "items": {"$ref": "#/definitions/phase"}
        },
        "observables": {
          "type": "array",
          "items": {"$ref": "#/definitions/observable"}
        },
        "visualizations": {
          "type": "array",
          "items": {"$ref": "#/definitions/visualization"}
        },
        "external": {"type": "boolean"}
      }
    },
    "import": {
      "type": "object",
      "required": ["source", "ref", "mode"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "mode": {"enum": ["reference", "fork-source", "in-place"]},
        "path": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]}
      }
    },
    "phase": {
      "type": "object",
      "required": ["n", "name", "status"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "status": {"enum": ["planned", "in_progress", "gate_pending", "complete"]},
        "pr": {"type": ["integer", "null"]},
        "gate_passed": {"type": "boolean"},
        "source_artifact": {
          "type": "object",
          "properties": {
            "kind": {"enum": ["expert_doc", "dataset", "reference", "claim"]},
            "ref": {"type": "string"}
          }
        }
      }
    },
    "observable": {
      "type": "object",
      "required": ["name", "store_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "store_path": {"type": "string", "minLength": 1},
        "units": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]}
      }
    },
    "visualization": {
      "type": "object",
      "required": ["name", "type", "observables"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["time-series", "phase-space", "heatmap", "histogram"]},
        "observables": {"type": "array", "items": {"type": "string"}},
        "config": {"type": "object"}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["name", "claims"],
      "properties": {
        "name": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "claims": {"type": "array", "items": {"type": "string"}}
      }
    },
    "expertDoc": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "contributor": {"type": ["string", "null"]},
        "claims_supported": {"type": "array", "items": {"type": "string"}}
      }
    },
    "referencePdf": {
      "type": "object",
      "required": ["bib_key", "path", "sha256"],
      "properties": {
        "bib_key": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "_metadata_pending": {"type": "boolean"}
      }
    }
  }
}
