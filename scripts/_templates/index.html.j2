<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><title>{{ workspace_name }}</title>
<link rel="stylesheet" href="assets/style.css">
<style>
/* Modal overlay */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #fff;
  border-radius: 8px;
  padding: 24px 28px;
  min-width: 360px;
  max-width: 560px;
  width: 100%;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  position: relative;
}
.modal-box h3 { margin-top: 0; }
.modal-box label { display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9em; }
.modal-box input, .modal-box select, .modal-box textarea {
  width: 100%; box-sizing: border-box;
  border: 1px solid #ccc; border-radius: 4px;
  padding: 6px 8px; font-size: 0.92em; margin-bottom: 12px;
}
.modal-box textarea { min-height: 90px; font-family: monospace; }
.modal-box button[type=submit] {
  background: #1976d2; color: #fff; border: none;
  border-radius: 4px; padding: 8px 18px; cursor: pointer; font-size: 0.95em;
}
.modal-box button[type=submit]:disabled { opacity: 0.6; cursor: not-allowed; }
.modal-close {
  position: absolute; top: 10px; right: 14px;
  background: none; border: none; font-size: 1.3em; cursor: pointer; color: #888;
}
.form-error { color: #c00; font-size: 0.9em; margin-top: 4px; min-height: 1.2em; }
.action-btn {
  margin-top: 10px; padding: 5px 12px;
  border: 1px solid #1976d2; background: #e3f2fd;
  border-radius: 4px; cursor: pointer; font-size: 0.88em;
}
.action-btn:hover { background: #bbdefb; }
.section-header {
  margin: 28px 0 6px 0;
  padding-bottom: 6px;
  border-bottom: 2px solid #e0e0e0;
  color: #333;
}
.section-lead {
  color: #666; font-size: 0.92em; margin: 0 0 16px 0; font-style: italic;
}
</style>
</head><body>
<header><h1>{{ workspace_name }}</h1>
<p class="subtitle">Workspace dashboard &middot; regenerated {{ generated_at }}</p></header>
<main>
<div id="guidance" class="guidance panel"></div>

{% if next_step %}
<div class="panel" id="walkthrough-panel" style="background:linear-gradient(180deg,#fff7e6,#fff);border-color:#f5b042">
  <div style="font-size:0.78em;letter-spacing:0.05em;color:#a86b00;font-weight:600;margin-bottom:6px">Next step</div>
  <h2 style="margin-top:0">{{ next_step.label }}</h2>
  {% if next_step.details %}<p>{{ next_step.details }}</p>{% endif %}
  {% if next_step.command %}<pre style="background:rgba(0,0,0,0.05);padding:10px;border-radius:4px;white-space:pre-wrap"><code>{{ next_step.command }}</code></pre>{% endif %}
  <p class="subtitle">Full guide in <code>NEXT_STEPS.md</code>.</p>
</div>
{% endif %}

<!-- ===== WORKSPACE INPUTS ===== -->
<h2 class="section-header">Workspace inputs</h2>
<p class="section-lead">Inputs the model builds on. Add and refresh anytime &mdash; there&rsquo;s no canonical &ldquo;completed&rdquo; state.</p>

<!-- Imports panel -->
<div class="panel">
  <h2>Imports</h2>
  <p class="stage-explainer">Register external models you want to reference, fork from, or operate against in-place. Optional &mdash; skip this if your project starts from scratch.</p>
  {% if imports %}
  <table><thead><tr><th>Name</th><th>Mode</th><th>Source</th></tr></thead><tbody>
  {% for name, imp in imports.items() %}
  <tr><td><code>{{ name }}</code></td><td>{{ imp.mode }}</td><td><code>{{ imp.source }}</code> @ <code>{{ imp.ref }}</code></td></tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No imports registered yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-import')">+ Add import</button>
</div>

<!-- Models input panel (registration) -->
<div class="panel"><h2>Models</h2>
<p class="stage-explainer">Each model is a git submodule under <code>models/&lt;name&gt;/</code> &mdash; its own GitHub repo. Add a model from the terminal: <code>gh repo create &lt;org&gt;/&lt;name&gt; &hellip;</code> + <code>git submodule add</code>.</p>
{% if models %}
<p style="color:#888;font-size:0.9em">Registered models are listed in the <strong>Models &mdash; lifecycle</strong> section below.</p>
{% else %}<p>No models yet. <code>/pbg-add-model &lt;name&gt;</code></p>{% endif %}
</div>

<!-- Datasets panel -->
<div class="panel">
  <h2>Datasets</h2>
  <p class="stage-explainer">Register datasets your model will compare against. Each entry maps to specific model claims it supports.</p>
  {% if datasets %}
  <table><thead><tr><th>Name</th><th>Source</th><th>Claims</th></tr></thead><tbody>
  {% for ds in datasets %}
  <tr>
    <td><code>{{ ds.name }}</code></td>
    <td><code>{% if ds.path %}{{ ds.path }}{% elif ds.url %}{{ ds.url }}{% endif %}</code></td>
    <td>{{ (ds.claims or [])|join(', ') }}</td>
  </tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No datasets registered yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-dataset')">+ Add dataset</button>
</div>

<!-- References panel -->
<div class="panel">
  <h2>References</h2>
  <p class="stage-explainer">BibTeX bibliography + claim &rarr; paper mapping. Adds entries to <code>references/papers.bib</code> and <code>references/claims.yaml</code>.</p>
  <p>Entries in <code>references/papers.bib</code>: <strong>{{ references_count }}</strong> &nbsp;&middot;&nbsp; PDFs committed: <strong>{{ (references_pdfs or [])|length }}</strong></p>
  {% if references_pdfs %}
  <table style="font-size:0.86em;margin-bottom:10px"><thead><tr><th>Bib key</th><th>Path</th><th>SHA256 (trunc)</th></tr></thead><tbody>
  {% for pdf in references_pdfs %}
  <tr>
    <td><code>{{ pdf.bib_key }}</code>{% if pdf._metadata_pending %} <span class="stage-label optional">Needs metadata</span>{% endif %}</td>
    <td><a href="/{{ pdf.path }}">{{ pdf.path }}</a></td>
    <td><code>{{ pdf.sha256[:8] }}&hellip;</code></td>
  </tr>
  {% endfor %}
  </tbody></table>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-reference')">+ Add reference (PDF)</button>
</div>

<!-- Expert knowledge panel -->
<div class="panel">
  <h2>Expert knowledge</h2>
  <p class="stage-explainer">Curated expert documents &mdash; PDFs, lab notes, expert review docs &mdash; that aren&rsquo;t formal publications but capture domain knowledge driving the model. Linked to the claims they support.</p>
  {% if expert_docs %}
  <table><thead><tr><th>Name</th><th>File</th><th>Description</th><th>Contributor</th><th>Claims</th></tr></thead><tbody>
  {% for doc in expert_docs %}
  <tr>
    <td><strong>{{ doc.name }}</strong></td>
    <td><a href="/{{ doc.path }}">{{ doc.path }}</a></td>
    <td>{{ doc.description or '' }}</td>
    <td>{{ doc.contributor or '' }}</td>
    <td>{{ (doc.claims_supported or [])|join(', ') }}</td>
  </tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No expert documents registered yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-expert-doc')">+ Add expert document</button>
</div>

<!-- ===== MODELS — LIFECYCLE ===== -->
{% if models %}
<h2 class="section-header">Models &mdash; lifecycle</h2>

<div class="panel">
  <table>
    <thead><tr><th>Model</th><th>Setup</th><th>Mechanisms integrated</th><th>Deep dive</th></tr></thead>
    <tbody>
    {% for name, m in models.items() %}
    <tr>
      <td><code>{{ name }}</code></td>
      <td>{{ (m.observables or [])|length }} observables, {{ (m.visualizations or [])|length }} viz</td>
      <td>{{ (m.phases or [])|selectattr('status', 'equalto', 'complete')|list|length }} / {{ (m.phases or [])|length }}</td>
      <td><a href="../models/{{ name }}/reports/index.html">deep dive &rarr;</a></td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<!-- Branch timeline panel -->
<div class="panel">
  <h2>Branch timeline</h2>
  <p class="stage-explainer">Every action above creates a feature branch. Open PRs from your terminal: <code>gh pr create --base main --head &lt;branch&gt;</code>.</p>
  <div id="branch-timeline-body"><p style="color:#888;font-style:italic">Loading&hellip;</p></div>
</div>

</main>

<!-- ============================================================ -->
<!-- MODALS -->
<!-- ============================================================ -->

<!-- Import modal -->
<div id="modal-import" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-import')">&times;</button>
    <h3>Add import</h3>
    <p style="font-size:0.85em;color:#555">
      Registers the import in <code>workspace.yaml</code> on a new <code>stage/0.5-import-*</code> branch.
      <strong>git submodule add</strong> is <em>not</em> performed here &mdash; run the terminal command shown after submit.
    </p>
    <form id="form-import" onsubmit="event.preventDefault(); submitForm(this, '/api/import')">
      <label>Name *<input name="name" placeholder="e.g. v2ecoli" required></label>
      <label>Source URL *<input name="source" placeholder="https://github.com/org/repo.git" required></label>
      <label>Ref *<input name="ref" placeholder="main" required></label>
      <label>Mode *
        <select name="mode">
          <option value="reference">reference (read-only submodule under external/)</option>
          <option value="fork-source">fork-source (catalog only; no checkout)</option>
          <option value="in-place">in-place (submodule under models/)</option>
        </select>
      </label>
      <label>Description (optional)<input name="description" placeholder="Short description"></label>
      <div class="form-error"></div>
      <button type="submit">Register import</button>
    </form>
  </div>
</div>

<!-- Dataset modal -->
<div id="modal-dataset" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-dataset')">&times;</button>
    <h3>Add dataset</h3>
    <form id="form-dataset" onsubmit="event.preventDefault(); _submitDataset(this)">
      <label>Name *<input name="name" placeholder="e.g. bremer-1996" required></label>
      <label style="margin-bottom:4px">Drop the data file here <small>(or skip if URL-based)</small></label>
      <div id="ds-drop-zone" class="drop-zone">
        <span class="drop-hint">Drag &amp; drop data file here, or click to select</span>
        <div class="file-info"></div>
        <div class="file-hash"></div>
      </div>
      <div id="ds-url-row" style="margin-top:8px">
        <label>URL <small>(required if no file dropped)</small><input name="url" placeholder="https://example.com/data.csv"></label>
        <label>SHA256 (required with URL)<input name="sha256" placeholder="abc123..."></label>
      </div>
      <label>Claims (comma-separated claim IDs)<input name="claims" placeholder="growth-rate-vs-medium, ribo-fraction"></label>
      <div class="form-error"></div>
      <button type="submit">Add dataset</button>
    </form>
  </div>
</div>

<!-- Reference modal -->
<div id="modal-reference" class="modal-overlay">
  <div class="modal-box" style="max-width:600px">
    <button class="modal-close" onclick="closeModal('modal-reference')">&times;</button>
    <h3>Add reference</h3>
    <p class="subtitle" style="font-size:0.85em;color:#555;margin-bottom:12px">
      Drop a PDF &mdash; metadata is auto-extracted from the PDF&rsquo;s embedded fields.
      Refine in the optional section below if extraction misses anything.
    </p>

    <label style="margin-bottom:4px;font-weight:600">Drop a PDF here *</label>
    <div id="ref-pdf-drop-zone" class="drop-zone">
      <span class="drop-hint">&#128196; Drop a PDF here, or click to browse</span>
      <div class="file-info"></div>
      <div class="file-hash"></div>
    </div>

    <details style="margin-top:14px">
      <summary style="cursor:pointer;font-size:0.88em;color:#555;font-weight:600">Refinements (optional)</summary>
      <div style="padding:12px 0;display:flex;flex-direction:column;gap:8px">
        <label style="font-size:0.88em">bib_key (auto-generated if blank):
          <input type="text" id="ref-bib_key" name="bib_key" placeholder="e.g. Smith2024" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Title (auto-extracted if blank):
          <input type="text" id="ref-title" name="title" placeholder="Full paper title" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Authors (semicolon-separated; auto-extracted if blank):
          <input type="text" id="ref-authors" name="authors" placeholder="Smith, J.; Doe, J." style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Year (auto-extracted if blank):
          <input type="number" id="ref-year" name="year" placeholder="2024" min="1000" max="2100" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Journal (optional):
          <input type="text" id="ref-journal" name="journal" placeholder="e.g. EcoSal Plus" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">DOI (optional):
          <input type="text" id="ref-doi" name="doi" placeholder="e.g. 10.1145/..." style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Maps to claims (comma-separated, optional):
          <input type="text" id="ref-claim_mappings" name="claim_mappings" placeholder="phase-1.dnaA-accumulation, rep-initiation" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
      </div>
    </details>

    <details style="margin-top:8px">
      <summary style="cursor:pointer;font-size:0.88em;color:#555;font-weight:600">Or paste an existing BibTeX entry (no PDF)</summary>
      <div style="padding:12px 0">
        <label style="font-size:0.88em;display:block">BibTeX entry:
          <textarea id="ref-bibtex_text" name="bibtex_text" rows="6" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px;font-family:monospace"
            placeholder="@article{Bremer1996,&#10;  author = {Bremer, H. and Dennis, P.},&#10;  title  = {...},&#10;  ...&#10;}"></textarea>
        </label>
        <label style="font-size:0.88em;display:block">Maps to claims (optional, format: <code>claim-id:bibkey, ...</code>):
          <input type="text" id="ref-bibtex_claim_mappings" name="bibtex_claim_mappings" placeholder="growth-rate-vs-medium:Bremer1996" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
      </div>
    </details>

    <div class="form-error" id="ref-form-error" style="margin-top:8px"></div>
    <div style="margin-top:12px;display:flex;gap:8px">
      <button class="action-btn" style="background:#1976d2;color:#fff;border-color:#1976d2" onclick="submitReferenceForm()">Submit</button>
      <button class="action-btn" onclick="closeModal('modal-reference')">Cancel</button>
    </div>
  </div>
</div>

<!-- Expert document modal -->
<div id="modal-expert-doc" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-expert-doc')">&times;</button>
    <h3>Add expert document</h3>
    <p style="font-size:0.85em;color:#555">
      Registers a local file (PDF, lab notes, etc.) in <code>workspace.yaml</code> and copies it to
      <code>references/expert/</code> on a new <code>stage/5-expert-doc-*</code> branch.
    </p>
    <form id="form-expert-doc" onsubmit="event.preventDefault(); _submitExpertDoc(this)">
      <label>Name * <small>(short label, used as filename stem)</small>
        <input name="name" placeholder="e.g. ecoli-replication-review-2025" required>
      </label>
      <label style="margin-bottom:4px">Drop the expert document here * <small>(PDF / md / txt / &hellip;)</small></label>
      <div id="expert-drop-zone" class="drop-zone">
        <span class="drop-hint">Drag &amp; drop file here, or click to select</span>
        <div class="file-info"></div>
        <div class="file-hash"></div>
      </div>
      <label style="margin-top:8px">Description (optional)
        <textarea name="description" placeholder="Expert review of E. coli chromosome replication mechanism"></textarea>
      </label>
      <label>Contributor (optional)
        <input name="contributor" placeholder="Dr. Jane Smith">
      </label>
      <label>Claims supported (optional, comma-separated claim IDs)
        <input name="claims_supported" placeholder="rep-initiation, ori-firing-rate">
      </label>
      <div class="form-error"></div>
      <button type="submit">Register expert document</button>
    </form>
  </div>
</div>

<script src="assets/render-helpers.js"></script>
<script src="assets/client.js" onerror="/* live mode unavailable */"></script>
<script src="assets/walkthrough.js" onerror="/* walkthrough unavailable */"></script>
<script>
// Initialize drop zones once walkthrough.js is loaded.
document.addEventListener("DOMContentLoaded", function() {
  if (typeof setupDropZone === "function") {
    setupDropZone("ds-drop-zone", "dataset");
    setupDropZone("ref-pdf-drop-zone", "reference_pdf_primary");  // primary drop-and-go zone
    setupDropZone("expert-drop-zone", "expert_doc");
  }
});

// Dataset form submission (v0.1.9: supports file_b64 or url).
function _submitDataset(form) {
  submitForm(form, '/api/dataset', function(f) {
    var data = { name: f.name.value.trim(), claims: f.claims.value.trim() };
    var stored = (typeof _dropZoneStore !== "undefined") ? _dropZoneStore["dataset"] : null;
    if (stored && stored.file_b64) {
      data.file_b64 = stored.file_b64;
      data.filename = stored.filename;
    } else {
      var url = f.url.value.trim();
      if (url) {
        data.url = url;
        if (f.sha256.value.trim()) data.sha256 = f.sha256.value.trim();
      } else {
        // Show error — neither file nor URL.
        var errEl = form.querySelector(".form-error");
        if (errEl) errEl.textContent = "Error: drop a file or enter a URL.";
        return null;
      }
    }
    return data;
  });
}

// Unified reference form submission (v0.1.12: drop-and-go).
// Routes to /api/reference-pdf if a PDF was dropped, or /api/reference-bibtex
// if only a BibTeX block was pasted.
function submitReferenceForm() {
  var errEl = document.getElementById("ref-form-error");
  if (errEl) errEl.textContent = "";

  var pdfStored = (typeof _dropZoneStore !== "undefined") ? _dropZoneStore["reference_pdf_primary"] : null;
  var bibtexText = (document.getElementById("ref-bibtex_text") || {}).value || "";
  bibtexText = bibtexText.trim();

  if (pdfStored && pdfStored.file_b64) {
    // PDF path — drop-and-go; all fields optional.
    var data = { pdf_b64: pdfStored.file_b64, pdf_filename: pdfStored.filename };
    var bibKey    = (document.getElementById("ref-bib_key") || {}).value || "";
    var title     = (document.getElementById("ref-title") || {}).value || "";
    var authors   = (document.getElementById("ref-authors") || {}).value || "";
    var yearStr   = (document.getElementById("ref-year") || {}).value || "";
    var journal   = (document.getElementById("ref-journal") || {}).value || "";
    var doi       = (document.getElementById("ref-doi") || {}).value || "";
    var claims    = (document.getElementById("ref-claim_mappings") || {}).value || "";
    if (bibKey.trim())  data.bib_key  = bibKey.trim();
    if (title.trim())   data.title    = title.trim();
    if (authors.trim()) data.authors  = authors.trim();
    if (yearStr.trim()) data.year     = parseInt(yearStr.trim(), 10);
    if (journal.trim()) data.journal  = journal.trim();
    if (doi.trim())     data.doi      = doi.trim();
    if (claims.trim()) {
      data.claim_mappings = claims.trim().split(",").map(function(s) { return s.trim(); }).filter(Boolean);
    }
    _postReferenceData("/api/reference-pdf", data);

  } else if (bibtexText) {
    // BibTeX-paste path — legacy flow.
    var bibClaims = (document.getElementById("ref-bibtex_claim_mappings") || {}).value || "";
    var data = { bibtex_text: bibtexText, claim_mappings: bibClaims.trim() };
    _postReferenceData("/api/reference-bibtex", data);

  } else {
    if (errEl) errEl.textContent = "Error: drop a PDF or paste a BibTeX entry.";
  }
}

function _postReferenceData(endpoint, data) {
  var errEl = document.getElementById("ref-form-error");
  fetch(endpoint, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(data),
  })
    .then(function(res) {
      return res.json().then(function(json) { return { ok: res.ok, status: res.status, json: json }; });
    })
    .then(function(r) {
      if (!r.ok) {
        var msg = (r.json && r.json.error) ? r.json.error : ("HTTP " + r.status);
        if (errEl) errEl.textContent = "Error: " + msg;
        return;
      }
      var branch = r.json.branch || "";
      var commit = r.json.commit || "";
      var bib_key = r.json.bib_key || "";
      var pending = r.json.metadata_pending;
      var msg = "Done!";
      if (bib_key) msg += " bib_key: " + bib_key;
      if (branch)  msg += "\nBranch: " + branch + (commit ? " (" + commit + ")" : "");
      if (pending) msg += "\n\nNote: metadata incomplete — entry marked 'Needs metadata'. Refine via the form.";
      fetch("/api/render", { method: "POST" }).finally(function() {
        alert(msg);
        location.reload();
      });
    })
    .catch(function(err) {
      if (errEl) errEl.textContent = "Network error: " + String(err);
    });
}

// Expert doc form submission (v0.1.9: file_b64 required).
function _submitExpertDoc(form) {
  submitForm(form, '/api/expert-doc', function(f) {
    var stored = (typeof _dropZoneStore !== "undefined") ? _dropZoneStore["expert_doc"] : null;
    if (!stored || !stored.file_b64) {
      var errEl = form.querySelector(".form-error");
      if (errEl) errEl.textContent = "Error: please drop or select a file first.";
      return null;
    }
    var data = {
      name: f.name.value.trim(),
      file_b64: stored.file_b64,
      filename: stored.filename,
    };
    if (f.description && f.description.value.trim()) data.description = f.description.value.trim();
    if (f.contributor && f.contributor.value.trim()) data.contributor = f.contributor.value.trim();
    if (f.claims_supported && f.claims_supported.value.trim()) data.claims_supported = f.claims_supported.value.trim();
    return data;
  });
}
</script>
</body></html>
