<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><title>{{ workspace_name }}</title>
<link rel="stylesheet" href="assets/style.css">
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
/* Modal overlay */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #fff;
  border-radius: 8px;
  padding: 24px 28px;
  min-width: 360px;
  max-width: 560px;
  width: 100%;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  position: relative;
}
.modal-box h3 { margin-top: 0; }
.modal-box label { display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9em; }
.modal-box input, .modal-box select, .modal-box textarea {
  width: 100%; box-sizing: border-box;
  border: 1px solid #ccc; border-radius: 4px;
  padding: 6px 8px; font-size: 0.92em; margin-bottom: 12px;
}
.modal-box textarea { min-height: 90px; font-family: monospace; }
.modal-box button[type=submit] {
  background: #1976d2; color: #fff; border: none;
  border-radius: 4px; padding: 8px 18px; cursor: pointer; font-size: 0.95em;
}
.modal-box button[type=submit]:disabled { opacity: 0.6; cursor: not-allowed; }
.modal-close {
  position: absolute; top: 10px; right: 14px;
  background: none; border: none; font-size: 1.3em; cursor: pointer; color: #888;
}
.form-error { color: #c00; font-size: 0.9em; margin-top: 4px; min-height: 1.2em; }
.action-btn {
  margin-top: 10px; padding: 5px 12px;
  border: 1px solid #1976d2; background: #e3f2fd;
  border-radius: 4px; cursor: pointer; font-size: 0.88em;
}
.action-btn:hover { background: #bbdefb; }
.action-btn-small {
  padding: 2px 8px; border: 1px solid #c62828; background: #ffebee;
  border-radius: 4px; cursor: pointer; font-size: 0.82em; color: #c62828;
}
.action-btn-small:hover { background: #ffcdd2; }
.pill-btn {
  font-size: 0.78em; padding: 2px 8px; border-radius: 3px;
  border: 1px solid #666; background: #fff; cursor: pointer; margin-left: 6px;
  vertical-align: middle;
}
.pill-btn:hover { background: #eee; }
.section-header {
  margin: 28px 0 6px 0;
  padding-bottom: 6px;
  border-bottom: 2px solid #e0e0e0;
  color: #333;
}
.section-lead {
  color: #666; font-size: 0.92em; margin: 0 0 16px 0; font-style: italic;
}
.source-artifact-tag {
  font-size: 0.78em; color: #555; font-style: italic; margin-left: 8px;
}
.pending-review-badge{
  display:inline-block;font-size:0.7em;background:#fef3c7;color:#a86b00;
  padding:2px 8px;border-radius:10px;margin-left:8px;
}
#run-tests-output {
  white-space: pre-wrap; font-family: monospace; font-size: 0.82em;
  background: #f8f8f8; border: 1px solid #ccc; border-radius: 4px;
  padding: 10px; margin-top: 10px; max-height: 420px; overflow-y: auto;
  display: none;
}
#run-tests-spinner { display: none; margin-left: 8px; color: #888; }
.panel-lead { color: #6b7280; margin-bottom: 16px; font-size: 0.92em; }
.status-pill.installed{ background:#d1fae5; color:#065f46 }
.status-pill.not_installed{ background:#fef3c7; color:#92400e }
.registry-hint{
  background:#eff6ff; border-left:4px solid #3b82f6; padding:10px 14px;
  border-radius:4px; margin:0 0 16px; font-size:0.92em;
}
</style>
</head><body>

<header class="top-header">
  <h1>{{ workspace_name }} dashboard</h1>
  <p class="subtitle">{% if workspace_description %}{{ workspace_description }}{% else %}Workspace dashboard &middot; regenerated {{ generated_at }}{% endif %}</p>
</header>

<nav class="top-menu" role="tablist">
  <a href="#workspace-inputs" class="menu-link" data-page="workspace-inputs">Workspace inputs</a>
  <a href="#simulation-setup" class="menu-link" data-page="simulation-setup">Simulation Setup</a>
  <a href="#visualizations" class="menu-link" data-page="visualizations">Visualizations</a>
  <a href="#registry" class="menu-link" data-page="registry">Registry</a>
  <a href="#build-model" class="menu-link" data-page="build-model">Build Model</a>
</nav>

<main class="pages" style="padding:20px;max-width:1200px;margin:0 auto">

<div id="guidance" class="guidance panel"></div>

{% if next_step %}
<div class="panel" id="walkthrough-panel" style="background:linear-gradient(180deg,#fff7e6,#fff);border-color:#f5b042">
  <div style="font-size:0.78em;letter-spacing:0.05em;color:#a86b00;font-weight:600;margin-bottom:6px">Next step</div>
  <h2 style="margin-top:0">{{ next_step.label }}</h2>
  {% if next_step.details %}<p>{{ next_step.details }}</p>{% endif %}
  {% if next_step.command %}<pre style="background:rgba(0,0,0,0.05);padding:10px;border-radius:4px;white-space:pre-wrap"><code>{{ next_step.command }}</code></pre>{% endif %}
</div>
{% endif %}

<!-- ===== PAGE: WORKSPACE INPUTS ===== -->
<section id="page-workspace-inputs" class="page" data-page="workspace-inputs">
  <h2 class="page-title">Workspace inputs</h2>
  <p class="page-lead">External resources you bring into the workspace. Imports give you reference models, datasets feed validation, references and expert docs anchor the science.</p>

  <p class="stage-explainer">
    Inputs you add via the panels below land on feature branches first
    (no immediate write to <code>main</code>). They show with a
    <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span> badge until
    you merge or open a PR &mdash; see the <strong>Branch timeline</strong> panel at the bottom of this page.
  </p>

  <!-- Imports panel -->
  <div class="panel">
    <h3>Imports</h3>
    <p class="panel-lead">Register external models you want to reference, fork from, or operate against in-place. Optional &mdash; skip if your project starts from scratch.</p>
    {% if imports %}
    <table><thead><tr><th>Name</th><th>Mode</th><th>Source</th><th>Status</th></tr></thead><tbody>
    {% for name, imp in imports.items() %}
    <tr>
      <td><code>{{ name }}</code></td>
      <td>{{ imp.mode }}</td>
      <td><code>{{ imp.source }}</code> @ <code>{{ imp.ref }}</code></td>
      <td>
        {% if imp.installed %}
          <span class="status-pill installed">installed</span>
        {% else %}
          <button class="action-btn-small" onclick="_installImport('{{ name }}')">Install</button>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
    {% for p in (pending.imports or []) %}
    <tr>
      <td><code>{{ p.entry.name }}</code> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td>{{ p.entry.mode or '' }}</td>
      <td><code>{{ p.entry.source or '' }}</code></td>
      <td></td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% elif pending.imports %}
    <p style="color:#888;font-style:italic">No imports on main yet.</p>
    <table><thead><tr><th>Name</th><th>Mode</th><th>Source</th><th>Status</th></tr></thead><tbody>
    {% for p in pending.imports %}
    <tr>
      <td><code>{{ p.entry.name }}</code> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td>{{ p.entry.mode or '' }}</td>
      <td><code>{{ p.entry.source or '' }}</code></td>
      <td></td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% else %}
    <p style="color:#888;font-style:italic">No imports registered yet.</p>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-import')">+ Add import</button>
  </div>

  <!-- Datasets panel -->
  <div class="panel">
    <h3>Datasets</h3>
    <p class="panel-lead">Register datasets your model will compare against. Each entry maps to specific model claims it supports.</p>
    {% if datasets %}
    <table><thead><tr><th>Name</th><th>Source</th><th>Claims</th></tr></thead><tbody>
    {% for ds in datasets %}
    <tr>
      <td><code>{{ ds.name }}</code></td>
      <td><code>{% if ds.path %}{{ ds.path }}{% elif ds.url %}{{ ds.url }}{% endif %}</code></td>
      <td>{{ (ds.claims or [])|join(', ') }}</td>
    </tr>
    {% endfor %}
    {% for p in (pending.datasets or []) %}
    <tr>
      <td><code>{{ p.entry.name }}</code> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td><code>{{ p.entry.path or p.entry.url or '' }}</code></td>
      <td>{{ (p.entry.claims or [])|join(', ') }}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% elif pending.datasets %}
    <p style="color:#888;font-style:italic">No datasets on main yet.</p>
    <table><thead><tr><th>Name</th><th>Source</th><th>Claims</th></tr></thead><tbody>
    {% for p in pending.datasets %}
    <tr>
      <td><code>{{ p.entry.name }}</code> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td><code>{{ p.entry.path or p.entry.url or '' }}</code></td>
      <td>{{ (p.entry.claims or [])|join(', ') }}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% else %}
    <p style="color:#888;font-style:italic">No datasets registered yet.</p>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-dataset')">+ Add dataset</button>
  </div>

  <!-- References panel -->
  <div class="panel">
    <h3>References</h3>
    <p class="panel-lead">BibTeX bibliography + claim &rarr; paper mapping. Adds entries to <code>references/papers.bib</code> and <code>references/claims.yaml</code>.</p>
    <p>Entries in <code>references/papers.bib</code>: <strong>{{ references_count }}</strong> &nbsp;&middot;&nbsp; PDFs committed: <strong>{{ (references_pdfs or [])|length }}</strong></p>
    {% if references_pdfs %}
    <table style="font-size:0.86em;margin-bottom:10px"><thead><tr><th>Bib key</th><th>Path</th><th>SHA256 (trunc)</th></tr></thead><tbody>
    {% for pdf in references_pdfs %}
    <tr>
      <td><code>{{ pdf.bib_key }}</code>{% if pdf._metadata_pending %} <span class="stage-label optional">Needs metadata</span>{% endif %}</td>
      <td><a href="/{{ pdf.path }}">{{ pdf.path }}</a></td>
      <td><code>{{ pdf.sha256[:8] }}&hellip;</code></td>
    </tr>
    {% endfor %}
    {% for p in (pending.references_pdfs or []) %}
    <tr>
      <td><code>{{ p.entry.bib_key }}</code> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td>{{ p.entry.path or '' }}</td>
      <td><code>{{ (p.entry.sha256 or '')[:8] }}&hellip;</code></td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% elif pending.references_pdfs %}
    <table style="font-size:0.86em;margin-bottom:10px"><thead><tr><th>Bib key</th><th>Path</th><th>SHA256 (trunc)</th></tr></thead><tbody>
    {% for p in pending.references_pdfs %}
    <tr>
      <td><code>{{ p.entry.bib_key }}</code> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td>{{ p.entry.path or '' }}</td>
      <td><code>{{ (p.entry.sha256 or '')[:8] }}&hellip;</code></td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-reference')">+ Add reference (PDF)</button>
  </div>

  <!-- Expert knowledge panel -->
  <div class="panel">
    <h3>Expert knowledge</h3>
    <p class="panel-lead">Curated expert documents &mdash; PDFs, lab notes, expert review docs &mdash; that aren&rsquo;t formal publications but capture domain knowledge driving the model. Linked to the claims they support.</p>
    {% if expert_docs %}
    <table><thead><tr><th>Name</th><th>File</th><th>Description</th><th>Contributor</th><th>Claims</th></tr></thead><tbody>
    {% for doc in expert_docs %}
    <tr>
      <td><strong>{{ doc.name }}</strong></td>
      <td><a href="/{{ doc.path }}">{{ doc.path }}</a></td>
      <td>{{ doc.description or '' }}</td>
      <td>{{ doc.contributor or '' }}</td>
      <td>{{ (doc.claims_supported or [])|join(', ') }}</td>
    </tr>
    {% endfor %}
    {% for p in (pending.expert_docs or []) %}
    <tr>
      <td><strong>{{ p.entry.name }}</strong> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td>{{ p.entry.path or '' }}</td>
      <td>{{ p.entry.description or '' }}</td>
      <td>{{ p.entry.contributor or '' }}</td>
      <td>{{ (p.entry.claims_supported or [])|join(', ') }}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% elif pending.expert_docs %}
    <table><thead><tr><th>Name</th><th>File</th><th>Description</th></tr></thead><tbody>
    {% for p in pending.expert_docs %}
    <tr>
      <td><strong>{{ p.entry.name }}</strong> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td>{{ p.entry.path or '' }}</td>
      <td>{{ p.entry.description or '' }}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% else %}
    <p style="color:#888;font-style:italic">No expert documents registered yet.</p>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-expert-doc')">+ Add expert document</button>
  </div>

</section>

<!-- ===== PAGE: SIMULATION SETUP ===== -->
<section id="page-simulation-setup" class="page" data-page="simulation-setup">
  <h2 class="page-title">Simulation Setup</h2>
  <p class="page-lead">Define how you&rsquo;ll run the model. Set up <strong>simulations</strong> (run configs: time interval, parameters, initial state) and the <strong>observables</strong> they record. Visualizations live in their own tab.</p>

  <!-- Observables panel -->
  <div class="panel">
    <h3>Observables</h3>
    <p class="panel-lead">State variables to track during a run. Each observable is a dotted path into the composite document (e.g. <code>chromosome.DnaA_count</code>).</p>
    {% if observables %}
    <table><thead><tr><th>Name</th><th>Store path</th><th>Units</th><th>Description</th></tr></thead><tbody>
    {% for obs in observables %}
    <tr>
      <td><strong>{{ obs.name }}</strong></td>
      <td><code>{{ obs.store_path }}</code></td>
      <td>{{ obs.units or '' }}</td>
      <td>{{ obs.description or '' }}</td>
    </tr>
    {% endfor %}
    {% for p in (pending.observables or []) %}
    <tr>
      <td><strong>{{ p.entry.name }}</strong> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td><code>{{ p.entry.store_path }}</code></td>
      <td>{{ p.entry.units or '' }}</td>
      <td>{{ p.entry.description or '' }}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% elif pending.observables %}
    <p style="color:#888;font-style:italic">No observables on main yet.</p>
    <table><thead><tr><th>Name</th><th>Store path</th><th>Units</th></tr></thead><tbody>
    {% for p in pending.observables %}
    <tr>
      <td><strong>{{ p.entry.name }}</strong> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td><code>{{ p.entry.store_path }}</code></td>
      <td>{{ p.entry.units or '' }}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% else %}
    <p style="color:#888;font-style:italic">No observables defined yet.</p>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-observable')">+ Add observable</button>
  </div>

  <!-- Simulations panel (NEW) -->
  <div class="panel">
    <h3>Simulations</h3>
    <p class="panel-lead">A simulation is a run configuration: initial state, parameter overrides, time interval, and emitter config. Each simulation produces a trajectory that visualizations can render.</p>

    {% if simulations %}
    <table>
      <thead><tr><th>Name</th><th>Description</th><th>Time</th><th>Phases</th><th>Processes</th><th>Actions</th></tr></thead>
      <tbody>
      {% for s in simulations %}
      <tr>
        <td><code>{{ s.name }}</code></td>
        <td>{{ s.description or '' }}</td>
        <td>{{ s.t_start }} &rarr; {{ s.t_end }}</td>
        <td>{% if s.phases %}{{ s.phases | join(', ') }}{% else %}<em>all</em>{% endif %}</td>
        <td>{% if s.processes %}{{ s.processes | join(', ') }}{% else %}<em>—</em>{% endif %}</td>
        <td><button class="action-btn-small" onclick="_deleteSimulation('{{ s.name }}')">Remove</button></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty-state" style="color:#888;font-style:italic">No simulations registered yet. Add one below.</p>
    {% endif %}

    <details style="margin-top:12px">
      <summary><strong>Add simulation</strong></summary>
      <div style="padding:12px 0">
      <form id="form-simulation" onsubmit="event.preventDefault(); _submitSimulation(this);">
        <label>Name <input name="sim_name" pattern="^[a-zA-Z0-9_-]+$" required placeholder="e.g. baseline-run"></label>
        <label>Description <input name="description" placeholder="Short description (optional)"></label>
        <label>t_start <input name="t_start" type="number" step="any" min="0" value="0" required></label>
        <label>t_end <input name="t_end" type="number" step="any" required placeholder="e.g. 3600"></label>
        <label>Initial state (JSON) <textarea name="initial_state" rows="3" placeholder="{}"></textarea></label>
        <label>Parameter overrides (JSON) <textarea name="parameter_overrides" rows="3" placeholder="{}"></textarea></label>
        <label>Emitter config (JSON) <textarea name="emitter_config" rows="3" placeholder="{}"></textarea></label>
        <fieldset style="border:1px solid #ddd;border-radius:4px;padding:10px;margin-bottom:12px">
          <legend style="font-size:0.88em;font-weight:600">Phases (leave all unchecked = applies globally)</legend>
          {% for p in phases %}
          <label style="display:inline-block; margin-right:12px; font-weight:normal">
            <input type="checkbox" name="phases" value="{{ p.n }}">
            Phase {{ p.n }}: {{ p.name }}
          </label>
          {% endfor %}
          {% if not phases %}<em style="color:#888;font-size:0.88em">No phases registered yet &mdash; simulation will apply globally.</em>{% endif %}
        </fieldset>
        <fieldset style="border:1px solid #ddd;border-radius:4px;padding:10px;margin-bottom:12px">
          <legend style="font-size:0.88em;font-weight:600">Processes (loaded from Registry &mdash; leave all unchecked = no declared deps)</legend>
          <div id="sim-process-picker">
            <p class="muted">Click <a href="#registry" onclick="_switchPage('registry')">Registry</a> first to populate this list.</p>
          </div>
        </fieldset>
        <div class="form-error"></div>
        <button type="submit">Add simulation</button>
      </form>
      </div>
    </details>
  </div>

</section>

<!-- ===== PAGE: VISUALIZATIONS ===== -->
<section id="page-visualizations" class="page" data-page="visualizations">
  <h2 class="page-title">Visualizations</h2>
  <p class="page-lead">Charts that render observable trajectories from simulations. Each visualization can be scoped to specific phases and/or a specific simulation.</p>

  <div class="panel">
    <h3>Visualizations</h3>
    <p class="panel-lead">Define charts now; they will be populated when you run the model.</p>
    {% if visualizations %}
    <table><thead><tr><th>Name</th><th>Type</th><th>Observables</th><th>Phases</th><th>Simulation</th></tr></thead><tbody>
    {% for viz in visualizations %}
    <tr>
      <td><strong>{{ viz.name }}</strong></td>
      <td><code>{{ viz.type }}</code></td>
      <td>{{ viz.observables | join(', ') }}</td>
      <td>{% if viz.phases %}{{ viz.phases | join(', ') }}{% else %}<em>all</em>{% endif %}</td>
      <td>{% if viz.simulation %}<code>{{ viz.simulation }}</code>{% else %}<em>any</em>{% endif %}</td>
    </tr>
    {% endfor %}
    {% for p in (pending.visualizations or []) %}
    <tr>
      <td><strong>{{ p.entry.name }}</strong> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td><code>{{ p.entry.type }}</code></td>
      <td>{{ (p.entry.observables or []) | join(', ') }}</td>
      <td>{% if p.entry.phases %}{{ p.entry.phases | join(', ') }}{% else %}<em>all</em>{% endif %}</td>
      <td>{% if p.entry.simulation %}<code>{{ p.entry.simulation }}</code>{% else %}<em>any</em>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% elif pending.visualizations %}
    <p style="color:#888;font-style:italic">No visualizations on main yet.</p>
    <table><thead><tr><th>Name</th><th>Type</th><th>Observables</th><th>Phases</th><th>Simulation</th></tr></thead><tbody>
    {% for p in pending.visualizations %}
    <tr>
      <td><strong>{{ p.entry.name }}</strong> <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span><br><small style="color:#888">branch: {{ p.branch }}</small></td>
      <td><code>{{ p.entry.type }}</code></td>
      <td>{{ (p.entry.observables or []) | join(', ') }}</td>
      <td>{% if p.entry.phases %}{{ p.entry.phases | join(', ') }}{% else %}<em>all</em>{% endif %}</td>
      <td>{% if p.entry.simulation %}<code>{{ p.entry.simulation }}</code>{% else %}<em>any</em>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% else %}
    <p style="color:#888;font-style:italic">No visualizations defined yet.</p>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-visualization')">+ Add visualization</button>
  </div>

</section>

<!-- ===== PAGE: REGISTRY ===== -->
<section id="page-registry" class="page" data-page="registry">
  <h2 class="page-title">Registry</h2>
  <p class="page-lead">Live snapshot of <code>build_core()</code> for this workspace &mdash; every process and type currently registered. This is what your simulations have access to. Use the refresh button after changing core code.</p>

  <aside class="registry-hint">
    <strong>Note:</strong> Only pip-installed packages with <code>bigraph-schema</code> as a dependency
    appear here. To make an import discoverable, click <strong>Install</strong> on its row in
    <a href="#workspace-inputs">Workspace inputs &rarr; Imports</a>.
  </aside>

  <button class="action-btn" onclick="_loadRegistry(true)">Refresh registry</button>
  <div id="registry-status" class="muted" style="margin:8px 0"></div>

  <section class="panel">
    <h3>Processes <span id="registry-process-count" class="count-badge"></span></h3>
    <div id="registry-processes-container">
      <p class="empty-state">Loading&hellip;</p>
    </div>
  </section>

  <section class="panel">
    <h3>Types <span id="registry-type-count" class="count-badge"></span></h3>
    <div id="registry-types-container">
      <p class="empty-state">Loading&hellip;</p>
    </div>
  </section>
</section>

<!-- ===== PAGE: BUILD MODEL ===== -->
<section id="page-build-model" class="page" data-page="build-model">
  <h2 class="page-title">Build Model</h2>
  <p class="page-lead">Iterative phases of model development. Each phase is modular: its own scope, acceptance tests, and visualizations.</p>

  <div class="panel">
    <h3>Phase tracker</h3>
    {% if current_phase %}
    <div class="current-phase-banner">
      <strong>Currently on Phase {{ current_phase.n }}: {{ current_phase.name }}</strong>
      <span class="status-pill {{ current_phase.status }}">{{ current_phase.status }}</span>
    </div>
    {% endif %}
    {% if phases %}
    <div class="phase-tracker">
    {% for p in phases %}
    <a class="pill {{ p.status }}{% if current_phase and p.n == current_phase.n %} current{% endif %}"
       href="#phase-{{ p.n }}">
      <strong>{{ p.n }} &middot; {{ p.name }}</strong><br>
      <small>{{ p.status }}</small>
    </a>
    {% endfor %}
    {% for p in (pending.phases or []) %}
    <div class="pill planned">
      <strong>{{ p.entry.n }} &middot; {{ p.entry.name }}</strong>
      <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span>
      <br><small style="color:#888">branch: {{ p.branch }}</small>
    </div>
    {% endfor %}
    </div>
    {% else %}
    {% if pending.phases %}
    <p style="color:#888;font-style:italic">No phases on main yet.</p>
    <div class="phase-tracker">
    {% for p in pending.phases %}
    <div class="pill planned">
      <strong>{{ p.entry.n }} &middot; {{ p.entry.name }}</strong>
      <span class="pending-review-badge" title="Lives on a feature branch — click 'Branch timeline' below to merge or open a PR">pending review</span>
      <br><small style="color:#888">branch: {{ p.branch }}</small>
    </div>
    {% endfor %}
    </div>
    {% else %}
    <p>No phases planned yet.</p>
    {% endif %}
    <button class="action-btn" onclick="openModal('modal-phase-plan')">+ Add phase plan</button>
    {% endif %}
    {% if phases %}
    <button class="action-btn" style="margin-top:10px" onclick="openModal('modal-phase-plan')">+ Add more phases</button>
    {% endif %}
  </div>

  <!-- Phase details -->
  {% for pd in phase_details %}
  <div class="panel phase-detail" id="phase-{{ pd.n }}">
    <h3>Phase {{ pd.n }}: {{ pd.frontmatter.name }}
      <span class="status-pill {{ pd.frontmatter.status }}">{{ pd.frontmatter.status }}</span>
    </h3>

    {% if pd.frontmatter.source_artifact %}
    <p class="source-artifact">Based on
      <strong>{{ pd.frontmatter.source_artifact.kind }}</strong>:
      <code>{{ pd.frontmatter.source_artifact.ref }}</code>
    </p>
    {% endif %}

    <details {% if pd.frontmatter.status == 'in_progress' %}open{% endif %}>
      <summary><strong>Body</strong> &mdash; objective, expected behavior, gate</summary>
      <div class="phase-body markdown-body">{{ pd.body | safe }}</div>
    </details>

    <div class="phase-detail-section">
      <strong>Applicable visualizations</strong>
      {% set applicable_viz = visualizations | selectattr('phases', 'defined') | list %}
      {% set global_viz = [] %}
      {% for v in visualizations %}
        {% if not v.phases or v.phases | length == 0 %}
          {% set _ = global_viz.append(v) %}
        {% endif %}
      {% endfor %}
      {% set phase_viz = [] %}
      {% for v in applicable_viz %}
        {% if pd.n in v.phases %}
          {% set _ = phase_viz.append(v) %}
        {% endif %}
      {% endfor %}
      {% set show_viz = phase_viz + global_viz %}
      {% if show_viz %}
      <ul>
        {% for v in show_viz %}
        <li><code>{{ v.name }}</code> ({{ v.type }}) &mdash; observables: {{ v.observables | join(', ') }}
          {% if not v.phases or v.phases | length == 0 %}<em>(global)</em>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p style="color:#888;font-style:italic">No visualizations apply to this phase yet.</p>
      {% endif %}
    </div>

    {% if pd.frontmatter.acceptance_tests %}
    <div class="phase-detail-section">
      <strong>Acceptance tests</strong>
      <table>
        <thead><tr><th>ID</th><th>Description</th><th>Status</th></tr></thead>
        <tbody>
        {% for t in pd.frontmatter.acceptance_tests %}
        <tr>
          <td><code>{{ t.id }}</code></td>
          <td>{{ t.desc }}</td>
          <td><span class="status-pill {{ t.status }}">{{ t.status }}</span></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    <div class="phase-detail-actions">
      {% if pd.frontmatter.status == 'planned' %}
      <button class="action-btn" onclick="_postPhaseAction('phase-start', {n: {{ pd.n }} })">Start phase</button>
      {% elif pd.frontmatter.status in ['in_progress', 'gate_pending'] %}
      <button class="action-btn" onclick="_postPhaseAction('phase-gate', {n: {{ pd.n }} })">Evaluate gate</button>
      {% endif %}
    </div>
  </div>
  {% endfor %}

  <!-- Reference sub-section -->
  {% if registry_warning %}
  <div class="panel" style="background:#fff3cd;border-color:#ffc107">
    <strong>Warning:</strong> {{ registry_warning }}
  </div>
  {% endif %}

  <div class="panel"><h3>Process registry</h3>
  {% if registry and registry.processes %}
  <table><thead><tr><th>Name</th></tr></thead><tbody>
  {% for proc in registry.processes %}<tr><td><code>{{ proc }}</code></td></tr>{% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No processes registered yet. Install the workspace package or run <code>/pbg-pull-processes</code>.</p>
  {% endif %}
  </div>

  <div class="panel"><h3>Type registry</h3>
  {% if registry and registry.types %}
  <table><thead><tr><th>Type</th></tr></thead><tbody>
  {% for t in registry.types %}<tr><td><code>{{ t }}</code></td></tr>{% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No custom types yet.</p>
  {% endif %}
  </div>

  <div class="panel"><h3>Composite document</h3>
  <p class="stage-explainer">Browsable process-bigraph document for <code>{{ package_path or 'workspace package' }}</code>.</p>
  <div id="pbg-tree" class="json-tree"></div>
  <script>
  const PBG_DOC = {{ pbg_doc_json | safe }};
  document.getElementById('pbg-tree').innerHTML = window.renderJsonTree ? window.renderJsonTree(PBG_DOC) : '<pre>' + JSON.stringify(PBG_DOC, null, 2) + '</pre>';
  </script>
  </div>

  <div class="panel">
    <h3>Run tests</h3>
    <p class="stage-explainer">Runs <code>pytest -v tests/</code> at workspace root.</p>
    <button id="run-tests-btn" class="action-btn" onclick="runTests()">Run pytest</button>
    <span id="run-tests-spinner">running&hellip;</span>
    <pre id="run-tests-output"></pre>
  </div>

</section>

</main>

<!-- Branch timeline — OUTSIDE .pages, always visible -->
<section class="below-pages" style="padding:20px;max-width:1200px;margin:0 auto">
  <h2>Branch timeline</h2>
  <p class="stage-explainer">Every action above creates a feature branch. Open PRs from your terminal: <code>gh pr create --base main --head &lt;branch&gt;</code>.</p>
  <div id="branch-timeline-body"><p style="color:#888;font-style:italic">Loading&hellip;</p></div>
</section>

<!-- ============================================================ -->
<!-- MODALS -->
<!-- ============================================================ -->

<!-- Import modal -->
<div id="modal-import" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-import')">&times;</button>
    <h3>Add import</h3>
    <p style="font-size:0.85em;color:#555">
      Registers the import in <code>workspace.yaml</code> on a new <code>stage/0.5-import-*</code> branch.
      <strong>git submodule add</strong> is <em>not</em> performed here &mdash; run the terminal command shown after submit.
    </p>
    <form id="form-import" onsubmit="event.preventDefault(); submitForm(this, '/api/import')">
      <label>Name *<input name="name" placeholder="e.g. v2ecoli" required></label>
      <label>Source URL *<input name="source" placeholder="https://github.com/org/repo.git" required></label>
      <label>Ref *<input name="ref" placeholder="main" required></label>
      <label>Mode *
        <select name="mode">
          <option value="reference">reference (read-only under external/)</option>
          <option value="fork-source">fork-source (catalog only)</option>
          <option value="in-place">in-place (submodule under external/)</option>
        </select>
      </label>
      <label>Description (optional)<input name="description" placeholder="Short description"></label>
      <div class="form-error"></div>
      <button type="submit">Register import</button>
    </form>
  </div>
</div>

<!-- Dataset modal -->
<div id="modal-dataset" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-dataset')">&times;</button>
    <h3>Add dataset</h3>
    <form id="form-dataset" onsubmit="event.preventDefault(); _submitDataset(this)">
      <label>Name *<input name="name" placeholder="e.g. bremer-1996" required></label>
      <label style="margin-bottom:4px">Drop the data file here <small>(or skip if URL-based)</small></label>
      <div id="ds-drop-zone" class="drop-zone">
        <span class="drop-hint">Drag &amp; drop data file here, or click to select</span>
        <div class="file-info"></div>
        <div class="file-hash"></div>
      </div>
      <div id="ds-url-row" style="margin-top:8px">
        <label>URL <small>(required if no file dropped)</small><input name="url" placeholder="https://example.com/data.csv"></label>
        <label>SHA256 (required with URL)<input name="sha256" placeholder="abc123..."></label>
      </div>
      <label>Claims (comma-separated claim IDs)<input name="claims" placeholder="growth-rate-vs-medium, ribo-fraction"></label>
      <div class="form-error"></div>
      <button type="submit">Add dataset</button>
    </form>
  </div>
</div>

<!-- Reference modal -->
<div id="modal-reference" class="modal-overlay">
  <div class="modal-box" style="max-width:600px">
    <button class="modal-close" onclick="closeModal('modal-reference')">&times;</button>
    <h3>Add reference</h3>
    <p class="subtitle" style="font-size:0.85em;color:#555;margin-bottom:12px">
      Drop a PDF &mdash; metadata is auto-extracted from the PDF&rsquo;s embedded fields.
    </p>

    <label style="margin-bottom:4px;font-weight:600">Drop a PDF here *</label>
    <div id="ref-pdf-drop-zone" class="drop-zone">
      <span class="drop-hint">&#128196; Drop a PDF here, or click to browse</span>
      <div class="file-info"></div>
      <div class="file-hash"></div>
    </div>

    <details style="margin-top:14px">
      <summary style="cursor:pointer;font-size:0.88em;color:#555;font-weight:600">Refinements (optional)</summary>
      <div style="padding:12px 0;display:flex;flex-direction:column;gap:8px">
        <label style="font-size:0.88em">bib_key (auto-generated if blank):
          <input type="text" id="ref-bib_key" name="bib_key" placeholder="e.g. Smith2024" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Title (auto-extracted if blank):
          <input type="text" id="ref-title" name="title" placeholder="Full paper title" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Authors (semicolon-separated; auto-extracted if blank):
          <input type="text" id="ref-authors" name="authors" placeholder="Smith, J.; Doe, J." style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Year (auto-extracted if blank):
          <input type="number" id="ref-year" name="year" placeholder="2024" min="1000" max="2100" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Journal (optional):
          <input type="text" id="ref-journal" name="journal" placeholder="e.g. EcoSal Plus" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">DOI (optional):
          <input type="text" id="ref-doi" name="doi" placeholder="e.g. 10.1145/..." style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
        <label style="font-size:0.88em">Maps to claims (comma-separated, optional):
          <input type="text" id="ref-claim_mappings" name="claim_mappings" placeholder="phase-1.dnaA-accumulation" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
      </div>
    </details>

    <details style="margin-top:8px">
      <summary style="cursor:pointer;font-size:0.88em;color:#555;font-weight:600">Or paste an existing BibTeX entry (no PDF)</summary>
      <div style="padding:12px 0">
        <label style="font-size:0.88em;display:block">BibTeX entry:
          <textarea id="ref-bibtex_text" name="bibtex_text" rows="6" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px;font-family:monospace"
            placeholder="@article{Bremer1996,&#10;  author = {Bremer, H. and Dennis, P.},&#10;  title  = {...},&#10;  ...&#10;}"></textarea>
        </label>
        <label style="font-size:0.88em;display:block">Maps to claims (optional, format: <code>claim-id:bibkey, ...</code>):
          <input type="text" id="ref-bibtex_claim_mappings" name="bibtex_claim_mappings" placeholder="growth-rate-vs-medium:Bremer1996" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:5px 8px">
        </label>
      </div>
    </details>

    <div class="form-error" id="ref-form-error" style="margin-top:8px"></div>
    <div style="margin-top:12px;display:flex;gap:8px">
      <button class="action-btn" style="background:#1976d2;color:#fff;border-color:#1976d2" onclick="submitReferenceForm()">Submit</button>
      <button class="action-btn" onclick="closeModal('modal-reference')">Cancel</button>
    </div>
  </div>
</div>

<!-- Expert document modal -->
<div id="modal-expert-doc" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-expert-doc')">&times;</button>
    <h3>Add expert document</h3>
    <p style="font-size:0.85em;color:#555">
      Registers a local file (PDF, lab notes, etc.) in <code>workspace.yaml</code> and copies it to
      <code>references/expert/</code> on a new <code>stage/5-expert-doc-*</code> branch.
    </p>
    <form id="form-expert-doc" onsubmit="event.preventDefault(); _submitExpertDoc(this)">
      <label>Name * <small>(short label, used as filename stem)</small>
        <input name="name" placeholder="e.g. ecoli-replication-review-2025" required>
      </label>
      <label style="margin-bottom:4px">Drop the expert document here * <small>(PDF / md / txt / &hellip;)</small></label>
      <div id="expert-drop-zone" class="drop-zone">
        <span class="drop-hint">Drag &amp; drop file here, or click to select</span>
        <div class="file-info"></div>
        <div class="file-hash"></div>
      </div>
      <label style="margin-top:8px">Description (optional)
        <textarea name="description" placeholder="Expert review of E. coli chromosome replication mechanism"></textarea>
      </label>
      <label>Contributor (optional)
        <input name="contributor" placeholder="Dr. Jane Smith">
      </label>
      <label>Claims supported (optional, comma-separated claim IDs)
        <input name="claims_supported" placeholder="rep-initiation, ori-firing-rate">
      </label>
      <div class="form-error"></div>
      <button type="submit">Register expert document</button>
    </form>
  </div>
</div>

<!-- Observable modal -->
<div id="modal-observable" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-observable')">&times;</button>
    <h3>Add observable</h3>
    <p style="font-size:0.85em;color:#555">Register a state variable to track. The store path is a dotted path into the composite document.</p>
    <form id="form-observable" onsubmit="event.preventDefault(); submitForm(this, '/api/observable', function(f){ return { name: f.obs_name.value.trim(), store_path: f.store_path.value.trim(), units: f.units.value.trim() || null, description: f.description.value.trim() || null }; })">
      <label>Name * <small>(e.g. DnaA)</small><input name="obs_name" placeholder="DnaA" required></label>
      <label>Store path * <small>(e.g. chromosome.DnaA_count)</small><input name="store_path" placeholder="chromosome.DnaA_count" required></label>
      <label>Units (optional)<input name="units" placeholder="molecules"></label>
      <label>Description (optional)<input name="description" placeholder="DnaA protein count in chromosome compartment"></label>
      <div class="form-error"></div>
      <button type="submit">Add observable</button>
    </form>
  </div>
</div>

<!-- Visualization modal -->
<div id="modal-visualization" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-visualization')">&times;</button>
    <h3>Add visualization</h3>
    <p style="font-size:0.85em;color:#555">Define a chart that renders registered observables.</p>
    <form id="form-visualization" onsubmit="event.preventDefault(); _submitVisualization(this)">
      <label>Name * <small>(e.g. dnaA-trajectory)</small><input name="viz_name" placeholder="dnaA-trajectory" required></label>
      <label>Type *
        <select name="viz_type">
          <option value="time-series">time-series</option>
          <option value="phase-space">phase-space</option>
          <option value="heatmap">heatmap</option>
          <option value="histogram">histogram</option>
        </select>
      </label>
      <label>Observables * <small>(comma-separated observable names)</small><input name="viz_observables" placeholder="DnaA, cell_mass" required></label>
      <label>Y-axis label (optional, for time-series)<input name="y_label" placeholder="DnaA (molecules)"></label>
      <label>Simulation (optional &mdash; leave blank to apply to any)
        <select name="simulation">
          <option value="">— any —</option>
          {% for s in simulations %}<option value="{{ s.name }}">{{ s.name }}</option>{% endfor %}
        </select>
      </label>
      <fieldset style="border:1px solid #ddd;border-radius:4px;padding:10px;margin-bottom:12px">
        <legend style="font-size:0.88em;font-weight:600">Applies to phases (leave all unchecked = applies globally)</legend>
        {% for p in phases %}
        <label style="display:inline-block; margin-right:12px; font-weight:normal">
          <input type="checkbox" name="phases" value="{{ p.n }}">
          Phase {{ p.n }}: {{ p.name }}
        </label>
        {% endfor %}
        {% if not phases %}<em style="color:#888;font-size:0.88em">No phases registered yet &mdash; visualization will apply globally.</em>{% endif %}
      </fieldset>
      <div class="form-error"></div>
      <button type="submit">Add visualization</button>
    </form>
  </div>
</div>

<!-- Phase plan modal -->
<div id="modal-phase-plan" class="modal-overlay">
  <div class="modal-box" style="max-width:640px">
    <button class="modal-close" onclick="closeModal('modal-phase-plan')">&times;</button>
    <h3>Add phase plan</h3>
    <p style="font-size:0.85em;color:#555">
      Enter phases as JSON. Each phase needs <code>n</code> (integer) and <code>name</code> (string).
