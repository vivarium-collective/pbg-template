<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><title>{{ model_name }}</title>
<link rel="stylesheet" href="assets/style.css">
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
/* Modal overlay */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #fff;
  border-radius: 8px;
  padding: 24px 28px;
  min-width: 360px;
  max-width: 560px;
  width: 100%;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  position: relative;
}
.modal-box h3 { margin-top: 0; }
.modal-box label { display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9em; }
.modal-box input, .modal-box select, .modal-box textarea {
  width: 100%; box-sizing: border-box;
  border: 1px solid #ccc; border-radius: 4px;
  padding: 6px 8px; font-size: 0.92em; margin-bottom: 12px;
}
.modal-box textarea { min-height: 80px; }
.modal-box button[type=submit] {
  background: #1976d2; color: #fff; border: none;
  border-radius: 4px; padding: 8px 18px; cursor: pointer; font-size: 0.95em;
}
.modal-box button[type=submit]:disabled { opacity: 0.6; cursor: not-allowed; }
.modal-close {
  position: absolute; top: 10px; right: 14px;
  background: none; border: none; font-size: 1.3em; cursor: pointer; color: #888;
}
.form-error { color: #c00; font-size: 0.9em; margin-top: 4px; min-height: 1.2em; }
.action-btn {
  margin-top: 10px; padding: 5px 12px;
  border: 1px solid #1976d2; background: #e3f2fd;
  border-radius: 4px; cursor: pointer; font-size: 0.88em;
}
.action-btn:hover { background: #bbdefb; }
.pill-btn {
  font-size: 0.78em; padding: 2px 8px; border-radius: 3px;
  border: 1px solid #666; background: #fff; cursor: pointer; margin-left: 6px;
  vertical-align: middle;
}
.pill-btn:hover { background: #eee; }
#run-tests-output {
  white-space: pre-wrap; font-family: monospace; font-size: 0.82em;
  background: #f8f8f8; border: 1px solid #ccc; border-radius: 4px;
  padding: 10px; margin-top: 10px; max-height: 420px; overflow-y: auto;
  display: none;
}
#run-tests-spinner { display: none; margin-left: 8px; color: #888; }
</style>
</head><body>
<header>
<p><a href="../../../reports/index.html">&larr; workspace dashboard</a></p>
<h1>{{ model_name }}</h1>
<p class="subtitle">Per-model deep dive &middot; regenerated {{ generated_at }}</p></header>
<main>
<div id="guidance" class="guidance panel"></div>

{% if registry_warning %}
<div class="panel" style="background:#fff3cd;border-color:#ffc107">
  <strong>Warning:</strong> {{ registry_warning }}
</div>
{% endif %}

<!-- Phase tracker panel -->
<div class="panel"><h2>Phase tracker <span class="stage-label">Stage 8</span></h2>
{% if phases %}
<div class="tracker">
{% for p in phases %}
<div class="pill {{ p.status }}">
  <strong>{{ p.n }} &middot; {{ p.name }}</strong><br>{{ p.status }}
  {% if p.status == 'planned' %}
  <br><button class="pill-btn" onclick="phaseStart({{ p.n }})">Start</button>
  {% elif p.status in ('in_progress', 'gate_pending') %}
  <br><button class="pill-btn" onclick="phaseGate({{ p.n }})">Evaluate gate</button>
  {% elif p.status == 'complete' %}
  <br><button class="pill-btn" onclick="phaseGate({{ p.n }})">Re-evaluate</button>
  {% endif %}
</div>
{% endfor %}
</div>
{% else %}
<p>No phases yet.</p>
<button class="action-btn" onclick="openModal('modal-phase-plan')">+ Generate phase plan</button>
{% endif %}
</div>

<!-- Acceptance tests panel -->
<div class="panel">
  <h2>Acceptance tests <span class="stage-label">Stage 6</span></h2>
  {% if acceptance_tests %}
  <table><thead><tr><th>ID</th><th>Statement</th><th>Status</th></tr></thead><tbody>
  {% for t in acceptance_tests %}
  <tr><td><code>{{ t.id }}</code></td><td>{{ t.desc }}</td><td>{{ t.status }}</td></tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No acceptance tests defined yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-acceptance')">+ Add acceptance test</button>
</div>

<!-- Run tests panel -->
<div class="panel">
  <h2>Run tests</h2>
  <button id="run-tests-btn" class="action-btn" onclick="runTests('{{ model_name }}')">Run pytest</button>
  <span id="run-tests-spinner">running&hellip;</span>
  <pre id="run-tests-output"></pre>
</div>

<!-- Process registry panel -->
<div class="panel"><h2>Process registry <span class="stage-label">Stage 3 + 7</span></h2>
{% if registry.processes %}<table><thead><tr><th>Name</th></tr></thead><tbody>
{% for proc in registry.processes %}<tr><td><code>{{ proc }}</code></td></tr>{% endfor %}
</tbody></table>
{% else %}<p>No processes registered yet (run <code>/pbg-pull-processes</code> + <code>/pbg-baseline</code>).</p>{% endif %}
</div>

<!-- Type registry panel -->
<div class="panel"><h2>Type registry</h2>
{% if registry.types %}<table><thead><tr><th>Type</th></tr></thead><tbody>
{% for t in registry.types %}<tr><td><code>{{ t }}</code></td></tr>{% endfor %}
</tbody></table>
{% else %}<p>No custom types yet.</p>{% endif %}
</div>

{% for p in phases if p.status == 'complete' %}
<div class="panel"><h3>Phase {{ p.n }} &middot; {{ p.name }} &mdash; deep dive</h3>
{% if p.deliverables and p.deliverables.plots %}{% for plot in p.deliverables.plots %}<img src="../phases/{{ plot }}" alt="">{% endfor %}{% endif %}
<h4>Acceptance tests</h4>
<table><thead><tr><th>ID</th><th>Description</th><th>Status</th></tr></thead><tbody>
{% for t in (p.acceptance_tests or []) %}<tr><td><code>{{ t.id }}</code></td><td>{{ t.desc }}</td><td>{{ t.status }}</td></tr>{% endfor %}
</tbody></table>
</div>
{% endfor %}

<!-- Composite document panel -->
<div class="panel"><h2>Composite document</h2>
<div id="pbg-tree" class="json-tree"></div>
<script>
const PBG_DOC = {{ pbg_doc_json | safe }};
document.getElementById('pbg-tree').innerHTML = window.renderJsonTree ? window.renderJsonTree(PBG_DOC) : '<pre>' + JSON.stringify(PBG_DOC, null, 2) + '</pre>';
</script>
</div>

</main>

<!-- ============================================================ -->
<!-- MODALS -->
<!-- ============================================================ -->

<!-- Acceptance test modal -->
<div id="modal-acceptance" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-acceptance')">&times;</button>
    <h3>Add acceptance test</h3>
    <form id="form-acceptance" onsubmit="event.preventDefault(); submitForm(this, '/api/acceptance', function(f){ return { model: '{{ model_name }}', test_id: f.test_id.value.trim(), statement: f.statement.value.trim(), perturbation: f.perturbation.value.trim(), observable: f.observable.value.trim() }; })">
      <label>Test ID * <small>(e.g. growth-rate-1)</small><input name="test_id" placeholder="growth-rate-1" required></label>
      <label>Statement * <small>("If X, then Y")</small><textarea name="statement" placeholder="If growth rate doubles, ribosome fraction increases by ~10%" required></textarea></label>
      <label>Perturbation (optional)<input name="perturbation" placeholder="Increase growth rate parameter by 2x"></label>
      <label>Observable (optional)<input name="observable" placeholder="Ribosome mass fraction"></label>
      <div class="form-error"></div>
      <button type="submit">Add test</button>
    </form>
  </div>
</div>

<!-- Phase plan modal -->
<div id="modal-phase-plan" class="modal-overlay">
  <div class="modal-box" style="max-width:640px">
    <button class="modal-close" onclick="closeModal('modal-phase-plan')">&times;</button>
    <h3>Generate phase plan</h3>
    <p style="font-size:0.85em;color:#555">Define the phases for model <strong>{{ model_name }}</strong>. Each phase gets a <code>phases/phase-N.md</code> file.</p>
    <div>
      <label>Number of phases
        <select id="phase-count-sel" onchange="buildPhaseFields(this.value)">
          {% for n in range(1, 11) %}<option value="{{ n }}"{% if n==3 %} selected{% endif %}>{{ n }}</option>{% endfor %}
        </select>
      </label>
    </div>
    <div id="phase-fields-container"></div>
    <div class="form-error" id="phase-plan-error"></div>
    <button type="button" style="background:#1976d2;color:#fff;border:none;border-radius:4px;padding:8px 18px;cursor:pointer;font-size:0.95em;margin-top:10px" onclick="submitPhasePlan()">Generate plan</button>
  </div>
</div>

<script src="assets/render-helpers.js"></script>
<script src="assets/client.js" onerror="/* live mode unavailable */"></script>
<script src="assets/walkthrough.js" onerror="/* walkthrough unavailable */"></script>
<script>
// Phase start / gate actions
function phaseStart(n) {
  if (!confirm('Start phase ' + n + ' for model {{ model_name }}? This will create a feature branch and mark it in_progress.')) return;
  fetch('/api/phase-start', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: '{{ model_name }}', n: n})
  }).then(function(r){ return r.json(); }).then(function(data){
    if (data.error) { alert('Error: ' + data.error); return; }
    fetch('/api/render', {method:'POST'}).finally(function(){
      alert('Phase ' + n + ' started. Branch: ' + data.branch + ' (' + data.commit + ')');
      location.reload();
    });
  }).catch(function(e){ alert('Network error: ' + e); });
}

function phaseGate(n) {
  if (!confirm('Evaluate gate for phase ' + n + '? This will create a feature branch with the gate result.')) return;
  fetch('/api/phase-gate', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: '{{ model_name }}', n: n})
  }).then(function(r){ return r.json(); }).then(function(data){
    if (data.error) { alert('Error: ' + data.error); return; }
    fetch('/api/render', {method:'POST'}).finally(function(){
      alert('Gate evaluated. Branch: ' + data.branch + ' (' + data.commit + ')');
      location.reload();
    });
  }).catch(function(e){ alert('Network error: ' + e); });
}

// Phase plan builder
function buildPhaseFields(count) {
  count = parseInt(count, 10);
  var container = document.getElementById('phase-fields-container');
  var html = '';
  for (var i = 1; i <= count; i++) {
    html += '<fieldset style="border:1px solid #ddd;border-radius:4px;padding:10px;margin-bottom:10px">';
    html += '<legend style="font-weight:600">Phase ' + i + '</legend>';
    html += '<label style="display:block;margin-bottom:4px;font-weight:600;font-size:0.9em">Name *<input id="phase-' + i + '-name" placeholder="e.g. Baseline" required style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:6px 8px;font-size:0.92em;margin-bottom:8px"></label>';
    html += '<label style="display:block;margin-bottom:4px;font-weight:600;font-size:0.9em">Objective<input id="phase-' + i + '-objective" placeholder="What this phase achieves" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:6px 8px;font-size:0.92em;margin-bottom:8px"></label>';
    html += '</fieldset>';
  }
  container.innerHTML = html;
}

function submitPhasePlan() {
  var count = parseInt(document.getElementById('phase-count-sel').value, 10);
  var phases = [];
  var errEl = document.getElementById('phase-plan-error');
  errEl.textContent = '';
  for (var i = 1; i <= count; i++) {
    var nameEl = document.getElementById('phase-' + i + '-name');
    var objEl = document.getElementById('phase-' + i + '-objective');
    if (!nameEl || !nameEl.value.trim()) {
      errEl.textContent = 'Phase ' + i + ' name is required.';
      return;
    }
    phases.push({ n: i, name: nameEl.value.trim(), objective: (objEl ? objEl.value.trim() : '') });
  }
  fetch('/api/phase-plan', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: '{{ model_name }}', phases: phases})
  }).then(function(r){ return r.json(); }).then(function(data){
    if (data.error) { errEl.textContent = 'Error: ' + data.error; return; }
    fetch('/api/render', {method:'POST'}).finally(function(){
      alert('Phase plan created. Branch: ' + data.branch + ' (' + data.commit + ')');
      location.reload();
    });
  }).catch(function(e){ errEl.textContent = 'Network error: ' + e; });
}

// Initialize phase plan fields on load.
document.addEventListener('DOMContentLoaded', function() {
  var sel = document.getElementById('phase-count-sel');
  if (sel) buildPhaseFields(sel.value);
});
</script>
</body></html>
