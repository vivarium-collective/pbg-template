<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><title>{{ model_name }}</title>
<link rel="stylesheet" href="assets/style.css">
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
/* Modal overlay */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #fff;
  border-radius: 8px;
  padding: 24px 28px;
  min-width: 360px;
  max-width: 560px;
  width: 100%;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  position: relative;
}
.modal-box h3 { margin-top: 0; }
.modal-box label { display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9em; }
.modal-box input, .modal-box select, .modal-box textarea {
  width: 100%; box-sizing: border-box;
  border: 1px solid #ccc; border-radius: 4px;
  padding: 6px 8px; font-size: 0.92em; margin-bottom: 12px;
}
.modal-box textarea { min-height: 80px; }
.modal-box button[type=submit] {
  background: #1976d2; color: #fff; border: none;
  border-radius: 4px; padding: 8px 18px; cursor: pointer; font-size: 0.95em;
}
.modal-box button[type=submit]:disabled { opacity: 0.6; cursor: not-allowed; }
.modal-close {
  position: absolute; top: 10px; right: 14px;
  background: none; border: none; font-size: 1.3em; cursor: pointer; color: #888;
}
.form-error { color: #c00; font-size: 0.9em; margin-top: 4px; min-height: 1.2em; }
.action-btn {
  margin-top: 10px; padding: 5px 12px;
  border: 1px solid #1976d2; background: #e3f2fd;
  border-radius: 4px; cursor: pointer; font-size: 0.88em;
}
.action-btn:hover { background: #bbdefb; }
.pill-btn {
  font-size: 0.78em; padding: 2px 8px; border-radius: 3px;
  border: 1px solid #666; background: #fff; cursor: pointer; margin-left: 6px;
  vertical-align: middle;
}
.pill-btn:hover { background: #eee; }
#run-tests-output {
  white-space: pre-wrap; font-family: monospace; font-size: 0.82em;
  background: #f8f8f8; border: 1px solid #ccc; border-radius: 4px;
  padding: 10px; margin-top: 10px; max-height: 420px; overflow-y: auto;
  display: none;
}
#run-tests-spinner { display: none; margin-left: 8px; color: #888; }
.section-header {
  margin: 28px 0 6px 0;
  padding-bottom: 6px;
  border-bottom: 2px solid #e0e0e0;
  color: #333;
}
.source-artifact-tag {
  font-size: 0.78em; color: #555; font-style: italic; margin-left: 8px;
}
</style>
</head><body>
<header>
<p><a href="../../../reports/index.html">&larr; workspace dashboard</a></p>
<h1>{{ model_name }}</h1>
<p class="subtitle">Per-model deep dive &middot; regenerated {{ generated_at }}</p></header>
<main>
<div id="guidance" class="guidance panel"></div>

{% if registry_warning %}
<div class="panel" style="background:#fff3cd;border-color:#ffc107">
  <strong>Warning:</strong> {{ registry_warning }}
</div>
{% endif %}

<!-- ===== SETUP ===== -->
<h2 class="section-header">Setup</h2>

<!-- Observables panel -->
<div class="panel">
  <h2>Observables</h2>
  <p class="stage-explainer">State variables to track during a run. Each observable is a dotted path into the composite document (e.g. <code>chromosome.DnaA_count</code>).</p>
  {% if observables %}
  <table><thead><tr><th>Name</th><th>Store path</th><th>Units</th><th>Description</th></tr></thead><tbody>
  {% for obs in observables %}
  <tr>
    <td><strong>{{ obs.name }}</strong></td>
    <td><code>{{ obs.store_path }}</code></td>
    <td>{{ obs.units or '' }}</td>
    <td>{{ obs.description or '' }}</td>
  </tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No observables defined yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-observable')">+ Add observable</button>
</div>

<!-- Visualizations panel -->
<div class="panel">
  <h2>Visualizations</h2>
  <p class="stage-explainer">Charts that render observable trajectories. Define them now; they will be populated when you run the model (v0.2.1).</p>
  {% if visualizations %}
  <table><thead><tr><th>Name</th><th>Type</th><th>Observables</th></tr></thead><tbody>
  {% for viz in visualizations %}
  <tr>
    <td><strong>{{ viz.name }}</strong></td>
    <td><code>{{ viz.type }}</code></td>
    <td>{{ viz.observables | join(', ') }}</td>
  </tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No visualizations defined yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-visualization')">+ Add visualization</button>
</div>

<!-- ===== INITIAL RUN ===== -->
<h2 class="section-header">Initial run</h2>

<div class="panel" style="background:#f5f5f5;border-color:#bdbdbd">
  <p style="color:#666;margin:0">
    <strong>v0.2.1</strong> will add a &ldquo;Run model&rdquo; button here that captures observable trajectories
    and renders the configured visualizations.
  </p>
</div>

<!-- ===== MECHANISM INTEGRATION ===== -->
<h2 class="section-header">Mechanism integration</h2>

<!-- Mechanism integration panel -->
<div class="panel">
  <h2>Mechanism integration</h2>
{% if phases %}
<div class="tracker">
{% for p in phases %}
<div class="pill {{ p.status }}">
  <strong>{{ p.n }} &middot; {{ p.name }}</strong><br>{{ p.status }}
  {% if p.source_artifact %}
  <span class="source-artifact-tag">based on: {{ p.source_artifact.kind }} &lsquo;{{ p.source_artifact.ref }}&rsquo;</span>
  {% endif %}
  {% if p.status == 'planned' %}
  <br><button class="pill-btn" onclick="phaseStart({{ p.n }})">Start</button>
  {% elif p.status in ('in_progress', 'gate_pending') %}
  <br><button class="pill-btn" onclick="phaseGate({{ p.n }})">Evaluate gate</button>
  {% elif p.status == 'complete' %}
  <br><button class="pill-btn" onclick="phaseGate({{ p.n }})">Re-evaluate</button>
  {% endif %}
</div>
{% endfor %}
</div>
{% else %}
<p>No mechanisms integrated yet.</p>
<button class="action-btn" onclick="openModal('modal-phase-plan')">+ Add mechanism plan</button>
{% endif %}
</div>

<!-- Acceptance tests panel -->
<div class="panel">
  <h2>Acceptance tests</h2>
  {% if acceptance_tests %}
  <table><thead><tr><th>ID</th><th>Statement</th><th>Status</th></tr></thead><tbody>
  {% for t in acceptance_tests %}
  <tr><td><code>{{ t.id }}</code></td><td>{{ t.desc }}</td><td>{{ t.status }}</td></tr>
  {% endfor %}
  </tbody></table>
  {% else %}
  <p style="color:#888;font-style:italic">No acceptance tests defined yet.</p>
  {% endif %}
  <button class="action-btn" onclick="openModal('modal-acceptance')">+ Add acceptance test</button>
</div>

{% for p in phases if p.status == 'complete' %}
<div class="panel"><h3>Mechanism {{ p.n }} &middot; {{ p.name }} &mdash; deep dive</h3>
{% if p.deliverables and p.deliverables.plots %}{% for plot in p.deliverables.plots %}<img src="../phases/{{ plot }}" alt="">{% endfor %}{% endif %}
<h4>Acceptance tests</h4>
<table><thead><tr><th>ID</th><th>Description</th><th>Status</th></tr></thead><tbody>
{% for t in (p.acceptance_tests or []) %}<tr><td><code>{{ t.id }}</code></td><td>{{ t.desc }}</td><td>{{ t.status }}</td></tr>{% endfor %}
</tbody></table>
</div>
{% endfor %}

<!-- ===== REFERENCE PANELS ===== -->
<h2 class="section-header">Reference</h2>

<!-- Process registry panel -->
<div class="panel"><h2>Process registry</h2>
{% if registry.processes %}<table><thead><tr><th>Name</th></tr></thead><tbody>
{% for proc in registry.processes %}<tr><td><code>{{ proc }}</code></td></tr>{% endfor %}
</tbody></table>
{% else %}<p>No processes registered yet (run <code>/pbg-pull-processes</code> + <code>/pbg-baseline</code>).</p>{% endif %}
</div>

<!-- Type registry panel -->
<div class="panel"><h2>Type registry</h2>
{% if registry.types %}<table><thead><tr><th>Type</th></tr></thead><tbody>
{% for t in registry.types %}<tr><td><code>{{ t }}</code></td></tr>{% endfor %}
</tbody></table>
{% else %}<p>No custom types yet.</p>{% endif %}
</div>

<!-- Composite document panel -->
<div class="panel"><h2>Composite document</h2>
<div id="pbg-tree" class="json-tree"></div>
<script>
const PBG_DOC = {{ pbg_doc_json | safe }};
document.getElementById('pbg-tree').innerHTML = window.renderJsonTree ? window.renderJsonTree(PBG_DOC) : '<pre>' + JSON.stringify(PBG_DOC, null, 2) + '</pre>';
</script>
</div>

<!-- Run tests panel -->
<div class="panel">
  <h2>Run tests</h2>
  <button id="run-tests-btn" class="action-btn" onclick="runTests('{{ model_name }}')">Run pytest</button>
  <span id="run-tests-spinner">running&hellip;</span>
  <pre id="run-tests-output"></pre>
</div>

</main>

<!-- ============================================================ -->
<!-- MODALS -->
<!-- ============================================================ -->

<!-- Observable modal -->
<div id="modal-observable" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-observable')">&times;</button>
    <h3>Add observable</h3>
    <p style="font-size:0.85em;color:#555">Register a state variable to track. The store path is a dotted path into the composite document.</p>
    <form id="form-observable" onsubmit="event.preventDefault(); submitForm(this, '/api/observable', function(f){ return { model: '{{ model_name }}', name: f.obs_name.value.trim(), store_path: f.store_path.value.trim(), units: f.units.value.trim() || null, description: f.description.value.trim() || null }; })">
      <label>Name * <small>(e.g. DnaA)</small><input name="obs_name" placeholder="DnaA" required></label>
      <label>Store path * <small>(e.g. chromosome.DnaA_count)</small><input name="store_path" placeholder="chromosome.DnaA_count" required></label>
      <label>Units (optional)<input name="units" placeholder="molecules"></label>
      <label>Description (optional)<input name="description" placeholder="DnaA protein count in chromosome compartment"></label>
      <div class="form-error"></div>
      <button type="submit">Add observable</button>
    </form>
  </div>
</div>

<!-- Visualization modal -->
<div id="modal-visualization" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-visualization')">&times;</button>
    <h3>Add visualization</h3>
    <p style="font-size:0.85em;color:#555">Define a chart that renders registered observables. Each observable in the list must already be registered above.</p>
    <form id="form-visualization" onsubmit="event.preventDefault(); _submitVisualization(this)">
      <label>Name * <small>(e.g. dnaA-trajectory)</small><input name="viz_name" placeholder="dnaA-trajectory" required></label>
      <label>Type *
        <select name="viz_type">
          <option value="time-series">time-series</option>
          <option value="phase-space">phase-space</option>
          <option value="heatmap">heatmap</option>
          <option value="histogram">histogram</option>
        </select>
      </label>
      <label>Observables * <small>(comma-separated observable names)</small><input name="viz_observables" placeholder="DnaA, cell_mass" required></label>
      <label>Y-axis label (optional, for time-series)<input name="y_label" placeholder="DnaA (molecules)"></label>
      <div class="form-error"></div>
      <button type="submit">Add visualization</button>
    </form>
  </div>
</div>

<!-- Acceptance test modal -->
<div id="modal-acceptance" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('modal-acceptance')">&times;</button>
    <h3>Add acceptance test</h3>
    <form id="form-acceptance" onsubmit="event.preventDefault(); submitForm(this, '/api/acceptance', function(f){ return { model: '{{ model_name }}', test_id: f.test_id.value.trim(), statement: f.statement.value.trim(), perturbation: f.perturbation.value.trim(), observable: f.observable.value.trim() }; })">
      <label>Test ID * <small>(e.g. growth-rate-1)</small><input name="test_id" placeholder="growth-rate-1" required></label>
      <label>Statement * <small>("If X, then Y")</small><textarea name="statement" placeholder="If growth rate doubles, ribosome fraction increases by ~10%" required></textarea></label>
      <label>Perturbation (optional)<input name="perturbation" placeholder="Increase growth rate parameter by 2x"></label>
      <label>Observable (optional)<input name="observable" placeholder="Ribosome mass fraction"></label>
      <div class="form-error"></div>
      <button type="submit">Add test</button>
    </form>
  </div>
</div>

<!-- Mechanism plan modal (renamed from "Phase plan") -->
<div id="modal-phase-plan" class="modal-overlay">
  <div class="modal-box" style="max-width:640px">
    <button class="modal-close" onclick="closeModal('modal-phase-plan')">&times;</button>
    <h3>Add mechanism plan</h3>
    <p style="font-size:0.85em;color:#555">Define the mechanisms to integrate into model <strong>{{ model_name }}</strong>. Each mechanism gets a <code>phases/phase-N.md</code> file.</p>
    <div>
      <label>Number of mechanisms
        <select id="phase-count-sel" onchange="buildPhaseFields(this.value)">
          {% for n in range(1, 11) %}<option value="{{ n }}"{% if n==3 %} selected{% endif %}>{{ n }}</option>{% endfor %}
        </select>
      </label>
    </div>
    <div id="phase-fields-container"></div>
    <div class="form-error" id="phase-plan-error"></div>
    <button type="button" style="background:#1976d2;color:#fff;border:none;border-radius:4px;padding:8px 18px;cursor:pointer;font-size:0.95em;margin-top:10px" onclick="submitPhasePlan()">Generate mechanism plan</button>
  </div>
</div>

<script src="assets/render-helpers.js"></script>
<script src="assets/client.js" onerror="/* live mode unavailable */"></script>
<script src="assets/walkthrough.js" onerror="/* walkthrough unavailable */"></script>
<script>
// Phase start / gate actions
function phaseStart(n) {
  if (!confirm('Start mechanism ' + n + ' for model {{ model_name }}? This will create a feature branch and mark it in_progress.')) return;
  fetch('/api/phase-start', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: '{{ model_name }}', n: n})
  }).then(function(r){ return r.json(); }).then(function(data){
    if (data.error) { alert('Error: ' + data.error); return; }
    fetch('/api/render', {method:'POST'}).finally(function(){
      alert('Mechanism ' + n + ' started. Branch: ' + data.branch + ' (' + data.commit + ')');
      location.reload();
    });
  }).catch(function(e){ alert('Network error: ' + e); });
}

function phaseGate(n) {
  if (!confirm('Evaluate gate for mechanism ' + n + '? This will create a feature branch with the gate result.')) return;
  fetch('/api/phase-gate', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: '{{ model_name }}', n: n})
  }).then(function(r){ return r.json(); }).then(function(data){
    if (data.error) { alert('Error: ' + data.error); return; }
    fetch('/api/render', {method:'POST'}).finally(function(){
      alert('Gate evaluated. Branch: ' + data.branch + ' (' + data.commit + ')');
      location.reload();
    });
  }).catch(function(e){ alert('Network error: ' + e); });
}

// Mechanism plan builder
function buildPhaseFields(count) {
  count = parseInt(count, 10);
  var container = document.getElementById('phase-fields-container');
  var html = '';
  for (var i = 1; i <= count; i++) {
    html += '<fieldset style="border:1px solid #ddd;border-radius:4px;padding:10px;margin-bottom:10px">';
    html += '<legend style="font-weight:600">Mechanism ' + i + '</legend>';
    html += '<label style="display:block;margin-bottom:4px;font-weight:600;font-size:0.9em">Name *<input id="phase-' + i + '-name" placeholder="e.g. DnaA accumulation" required style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:6px 8px;font-size:0.92em;margin-bottom:8px"></label>';
    html += '<label style="display:block;margin-bottom:4px;font-weight:600;font-size:0.9em">Objective<input id="phase-' + i + '-objective" placeholder="What this mechanism achieves" style="width:100%;box-sizing:border-box;border:1px solid #ccc;border-radius:4px;padding:6px 8px;font-size:0.92em;margin-bottom:8px"></label>';
    html += '</fieldset>';
  }
  container.innerHTML = html;
}

function submitPhasePlan() {
  var count = parseInt(document.getElementById('phase-count-sel').value, 10);
  var phases = [];
  var errEl = document.getElementById('phase-plan-error');
  errEl.textContent = '';
  for (var i = 1; i <= count; i++) {
    var nameEl = document.getElementById('phase-' + i + '-name');
    var objEl = document.getElementById('phase-' + i + '-objective');
    if (!nameEl || !nameEl.value.trim()) {
      errEl.textContent = 'Mechanism ' + i + ' name is required.';
      return;
    }
    phases.push({ n: i, name: nameEl.value.trim(), objective: (objEl ? objEl.value.trim() : '') });
  }
  fetch('/api/phase-plan', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({model: '{{ model_name }}', phases: phases})
  }).then(function(r){ return r.json(); }).then(function(data){
    if (data.error) { errEl.textContent = 'Error: ' + data.error; return; }
    fetch('/api/render', {method:'POST'}).finally(function(){
      alert('Mechanism plan created. Branch: ' + data.branch + ' (' + data.commit + ')');
      location.reload();
    });
  }).catch(function(e){ errEl.textContent = 'Network error: ' + e; });
}

// Visualization form submission
function _submitVisualization(form) {
  var obsRaw = form.viz_observables.value.trim();
  var obsList = obsRaw.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
  if (!obsList.length) {
    var errEl = form.querySelector('.form-error');
    if (errEl) errEl.textContent = 'Error: at least one observable is required.';
    return;
  }
  var data = {
    model: '{{ model_name }}',
    name: form.viz_name.value.trim(),
    type: form.viz_type.value,
    observables: obsList,
  };
  var yLabel = form.y_label ? form.y_label.value.trim() : '';
  if (yLabel) data.config = { y_label: yLabel };
  submitForm(form, '/api/visualization', function(){ return data; });
}

// Initialize mechanism plan fields on load.
document.addEventListener('DOMContentLoaded', function() {
  var sel = document.getElementById('phase-count-sel');
  if (sel) buildPhaseFields(sel.value);
});
</script>
</body></html>
